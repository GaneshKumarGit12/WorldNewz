{
  "redirects": [
    {
      "source": "/:path*",
      "destination": "https://worldnewzs.in/:path*",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/rss/:feedType",
      "destination": "https://worldnewz.onrender.com/rss/:feedType"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}