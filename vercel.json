{
  "cleanUrls": false,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "world-newz.vercel.app"
        }
      ],
      "destination": "https://worldnewzs.in/:path*",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "www.worldnewzs.in"
        }
      ],
      "destination": "https://worldnewzs.in/:path*",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/assets/:path*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/scripts/:path*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/favicon.svg",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400"
        }
      ]
    },
    {
      "source": "/(.*)\\.(svg|png|jpg|jpeg|ico|gif|webp)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/:path*",
      "headers": [
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains; preload"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Cross-Origin-Opener-Policy",
          "value": "unsafe-none"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' https:; connect-src 'self' https: wss:; img-src * data: blob: android-webview-video-poster:; style-src 'self' 'unsafe-inline' https:; font-src 'self' data: https:; frame-src 'self' https:; object-src 'none'; media-src * data: blob:;"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/ad-banner.html",
      "destination": "/ad-banner.html"
    },
    {
      "source": "/sw.js",
      "destination": "/sw.js"
    },
    {
      "source": "/sitemap.xml",
      "destination": "/api/sitemap"
    },
    {
      "source": "/news-sitemap.xml",
      "destination": "/api/news-sitemap"
    },
    {
      "source": "/",
      "destination": "/api/prerender?page=home"
    },
    {
      "source": "/jobs/post-job",
      "destination": "/api/prerender?page=jobs/post-job"
    },
    {
      "source": "/jobs/detail/:slug",
      "destination": "/api/prerender?jobSlug=:slug"
    },
    {
      "source": "/(politics|technology|business|science-health|lifestyle|education|opinion|trending|podcasts-videos|local-news|sports|money|weather|shopping|travel|food|entertainment|services|gaming|cartoons|stocks|badge-quiz|polls|about|contact|privacy-policy|terms|jobs|movies|transportation|chatbot|amazon-products)",
      "destination": "/api/prerender?page=$1"
    },
    {
      "source": "/article/:id",
      "destination": "/api/prerender?id=:id"
    },
    {
      "source": "/read-article/:id",
      "destination": "/api/prerender?id=:id"
    },
    {
      "source": "/rss/:feedType",
      "destination": "https://worldnewz.onrender.com/rss/:feedType"
    },
    {
      "source": "/api/pinterest/:path*",
      "destination": "https://worldnewz.onrender.com/api/pinterest/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
